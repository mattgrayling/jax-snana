# The quick start's simulation: a small DES-like survey of Type Ia supernovae
# generated with SALT3.DOVEKIE, on the observing history of a DES SIMLIB.
#
# Paths are relative to the working directory, so run from the root of the
# repository.

GENVERSION:  QUICKSTART
NGENTOT_LC:  300
BATCH_SIZE: 32
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  1
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
GENMODEL:  jax_snlc_core/data/models/SALT3.DOVEKIE
GENPEAK_SALT2x1:    0.0
GENRANGE_SALT2x1:  -2.0  2.0
GENSIGMA_SALT2x1:   1.0  1.0
GENPEAK_SALT2c:     0.0
GENRANGE_SALT2c:   -0.2  0.3
GENSIGMA_SALT2c:    0.05  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
GENFILTERS:  griz
KCOR_FILE:  tests/fixtures/data/kcor/JAX_TEST_DES.fits
SIMLIB_FILE:  tests/fixtures/data/simlib/JAX_TEST_DES_RFIELD.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
SEARCHEFF_PIPELINE_LOGIC_FILE:  NONE
SEARCHEFF_PIPELINE_EFF_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
GENRANGE_REDSHIFT:  0.05  1.2
GENSIGMA_REDSHIFT:  1.0E-3
GENSIGMA_VPEC:  0
VPEC_ERR:  0
GENRANGE_MJD:  56150.0  56365.0
GENRANGE_PEAKMJD:  56150.0  56365.0
GENSIGMA_PEAKMJD:  1.0
GENRANGE_TREST:  -20.0  50.0
SOLID_ANGLE:  0.020
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
DNDZ:  POWERLAW  2.5E-5  1.5
GENSOURCE:  RANDOM
RANSEED:  122459
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK SALT2x0 SALT2x1 SALT2c
NPE_PIXEL_SATURATE:  30000
PHOTFLAG_SATURATE:  1024
