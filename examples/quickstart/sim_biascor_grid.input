# A two-point alpha/beta grid for the multidimensional BBC example.
INPUT_FILE_INCLUDE: examples/quickstart/sim.input
GENVERSION: QUICKSTART_BIASCOR_GRID
NGENTOT_LC: 100000
GENRANGE_REDSHIFT: 0.05 1.3
RANSEED: 2
GENMAG_SMEAR: 0.10

GENPEAK_SALT2ALPHA: 0.14
GENRANGE_SALT2ALPHA: 0.08 0.20
GENSIGMA_SALT2ALPHA: 1.0E8 1.0E8
GENGRID_SALT2ALPHA: 2
GENPEAK_SALT2BETA: 3.1
GENRANGE_SALT2BETA: 2.0 4.2
GENSIGMA_SALT2BETA: 1.0E8 1.0E8
GENGRID_SALT2BETA: 2
