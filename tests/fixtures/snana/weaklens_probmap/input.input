# WEAKLENS_PROBMAP_FILE parity fixture: the lensing magnification draw, its
# DMUSCALE and the DMUERR_FRAC error the data file reports.
# Regenerated by `python tests/fixtures/regenerate.py --only weaklens_probmap`.
GENVERSION:  JAX_TEST_WEAKLENS_PROBMAP
NGENTOT_LC:  2000
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  1
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — bundled cropped SALT3.K21
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENPEAK_SALT2x1:    0.0
GENRANGE_SALT2x1:  -2.0  2.0
GENSIGMA_SALT2x1:   1.0  1.0
GENPEAK_SALT2c:     0.0
GENRANGE_SALT2c:   -0.2  0.3
GENSIGMA_SALT2c:    0.05  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Weak lensing: the bundled DES3YR probability map, a non-default DMUSCALE so
# the key is visible in the drawn distribution, and the DMUERR_FRAC that sets
# the reported LENSDMU_ERR (sntools_weaklens.c:257-277).
WEAKLENS_PROBMAP_FILE:  $JAX_TEST_FIXTURE_ROOT/lensing/LENSING_PROBMAP_LogNormal+MICECATv1.DAT
WEAKLENS_DMUSCALE:  1.5
WEAKLENS_DMUERR_FRAC:  0.2
# Redshift — inside the probability map's own coverage
GENRANGE_REDSHIFT:  0.0500  0.8000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  POWERLAW  2.5E-5  1.5
# Misc
GENSOURCE:  RANDOM
RANSEED:  40917
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU LENSDMU CUTMASK SALT2x0 SALT2x1 SALT2c
