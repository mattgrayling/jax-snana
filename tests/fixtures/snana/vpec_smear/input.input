# HOSTLIB end-to-end fixture: SNe drawn with a real HOSTLIB so HOSTGAL_*
# columns flow through to HEAD.FITS and DUMP.
GENVERSION:  JAX_TEST_VPEC_SMEAR
NGENTOT_LC:  300
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  1
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# SALT3 source model
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENPEAK_SALT2x1:    0.0
GENRANGE_SALT2x1:  -2.0  2.0
GENSIGMA_SALT2x1:   1.0  1.0
GENPEAK_SALT2c:     0.0
GENRANGE_SALT2c:   -0.2  0.3
GENSIGMA_SALT2c:    0.05  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# HOSTLIB
HOSTLIB_FILE:        $JAX_TEST_FIXTURE_ROOT/hostlib/JAX_TEST.HOSTLIB
HOSTLIB_MSKOPT:      258  # +2 (SNMAGSHIFT/HOSTNOISE off) +256 (verbose)
HOSTLIB_DZTOL:       0.0,0.05,0
HOSTLIB_STOREPAR:    LOGMASS,LOG_SFR,LOGsSFR
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Redshift — comfortably within HOSTLIB galaxy z range (HOSTLIB spans 0.02-0.5)
GENRANGE_REDSHIFT:  0.0500  0.3000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  300
VPEC_ERR:  300
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
DNDZ:  POWERLAW  2.5E-5  1.5
GENSOURCE:  RANDOM
RANSEED:  122459
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 14 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK SALT2x0 SALT2x1 SALT2c GALID GALZTRUE
