# Atmosphere/DCR (ATMOSPHERE_OPTMASK) replay parity fixture.
# Regenerated by `python tests/fixtures/regenerate.py --only atmosphere_replay`.
GENVERSION:  JAX_TEST_ATMOSPHERE_REPLAY
FORMAT_MASK:  32
NGENTOT_LC:  150
GENTYPE:  1
SNTYPES_Ia:  1  101
# Source model — bundled cropped SALT3.K21
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENPEAK_SALT2x1:    0.0
GENRANGE_SALT2x1:  -2.0  2.0
GENSIGMA_SALT2x1:   1.0  1.0
GENPEAK_SALT2c:     0.0
GENRANGE_SALT2c:   -0.2  0.3
GENSIGMA_SALT2c:    0.05  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument (SPECTRO kcor covers the ideal spectrograph range for SED-true)
GENFILTERS:  gri
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST_SPECTRO.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST_DCR.SIMLIB
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF off
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
# Redshift
GENRANGE_REDSHIFT:  0.0200  0.1500
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60560.0000  60640.0000
GENRANGE_PEAKMJD:  60575.0000  60620.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
# Galactic extinction off
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
DNDZ:  POWERLAW  2.5E-5  1.5
GENSOURCE:  RANDOM
RANSEED:  122459
OPT_SETPKMJD: 0
# Atmosphere / DCR (513 = DCR coords + per-obs .DCR dump)
ATMOSPHERE_OPTMASK:  513
ATMOSPHERE_SEDSTAR_FILE:  $JAX_TEST_FIXTURE_ROOT/atmosphere/calstar_sed.dat
ATMOSPHERE_DCR_COORDRES_POLY:  0.0,1.0
ATMOSPHERE_DCR_MAGSHIFT_POLY:  0.0,0.5
ATMOSPHERE_COORDRES_FLOOR:  0.01
LAMBIN_SED_TRUE:  20.0
LAMRANGE_SED_TRUE:  3000 9000
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK SALT2x0 SALT2x1 SALT2c
