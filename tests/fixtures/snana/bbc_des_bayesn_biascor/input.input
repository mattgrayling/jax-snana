# BayeSN W22 on the DES cadence, for the BayeSN BBC parity test.
# MSKOPT=0 is the only path that achieves SNANA-vs-JAX parity (DELTAM/EPSILON are
# absent from SIMGEN_DUMP under MSKOPT>=1, so the replay cannot be reproduced).
# Regenerated by `python tests/fixtures/regenerate.py --only bbc_des_bayesn_biascor`.
GENVERSION:  JAX_TEST_BBC_DES_BAYESN_BIASCOR
NGENTOT_LC:  4000
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  10
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/BAYESN.W22
GENMODEL_MSKOPT:  64
GENPEAK_THETA:  0.0
GENRANGE_THETA: -1.5  1.5
GENSIGMA_THETA: 0.7  0.7
GENPEAK_DELTAM:  0.0
GENRANGE_DELTAM: -0.4  0.4
GENSIGMA_DELTAM: 0.1  0.1
# Cosmology -- the BBC reference cosmology (p9=0.7, p11=-1), as the other DES fixtures
OMEGA_MATTER:  0.3000
OMEGA_LAMBDA:  0.7000
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
H0:  70.0
# Instrument -- bundled DES kcor + griz SIMLIB
GENFILTERS:  griz
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_DES.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_DES.SIMLIB
SOLID_ANGLE:  0.00456
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  1
CUTWIN_NEPOCH:   5 -5.
CUTWIN_SNRMAX:   5 griz 2 -20. 80.
# Require epochs inside the fitter's FITWIN_TREST (-10, 35). Without these a SN
# peaking at a season edge is generated with no epoch in the fit window, and the
# fitter returns it with no bands and an unconstrained distance.
CUTWIN_TRESTMIN: -10.0  2.0
CUTWIN_TRESTMAX:  10.0  35.0
# Redshift -- BayeSN W22 is a low-z model, so keep inside its training range
GENRANGE_REDSHIFT:  0.0500  0.2100
GENSIGMA_REDSHIFT:  0.001
GENSIGMA_VPEC:  0
VPEC_ERR:  0
GENRANGE_PEAKMJD:  56150.0  56365.0
GENSIGMA_SEARCH_PEAKMJD:  1.0
GENRANGE_TREST:  -20.0  50.0
GENRANGE_RA:    -360.0  360.0
GENRANGE_DECL:  -360.0  360.5
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Host extinction (BayeSN requires AV/RV to be sampled)
GENRANGE_AV:  0.0  0.5
GENTAU_AV:   0.4
GENRANGE_RV:  2.5  3.5
GENMEAN_RV:   3.1
GENSIGMA_RV:  0.3  0.3
DNDZ:  POWERLAW2 2.5E-5  1.5  0.0  0.4
GENSOURCE:  RANDOM
RANSEED:  987654
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK AV RV THETA
