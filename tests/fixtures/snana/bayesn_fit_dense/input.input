# BayeSN W22 on a dense cadence, fitted by snlc_fit.exe for the fitter tests.
# GENMODEL_MSKOPT 64: no scatter (replayable) and jax's phase extrapolation.
# Regenerated by `python tests/fixtures/regenerate.py --only bayesn_fit_dense`.
GENVERSION:  JAX_TEST_BAYESN_FIT_DENSE
NGENTOT_LC:  100
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  10
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — bundled BayeSN W22
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/BAYESN.W22
GENMODEL_MSKOPT:  64
GENPEAK_THETA:  0.0
GENRANGE_THETA: -1.5  1.5
GENSIGMA_THETA: 0.7  0.7
# DELTAM (intrinsic Hubble residual): no scatter bit is set, so it is unused,
# but JAX's parameter sampler still requires the distribution defined.
GENPEAK_DELTAM:  0.0
GENRANGE_DELTAM: -0.4  0.4
GENSIGMA_DELTAM: 0.1  0.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST_DENSE.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Redshift — low-z so SNe are bright enough to register
GENRANGE_REDSHIFT:  0.0200  0.2000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
# Host extinction (BayeSN requires AV/RV to be sampled)
GENRANGE_AV:  0.0  0.5
GENTAU_AV:   0.4
GENRANGE_RV:  2.5  3.5
GENMEAN_RV:   3.1
GENSIGMA_RV:  0.3  0.3
# Galactic extinction
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  POWERLAW2 2.5E-5  1.5  0.0  0.4
# Misc
GENSOURCE:  RANDOM
RANSEED:  122459
# Disable Fmax-clump peak recovery — keeps generated peak_mjd in the
# results dict, which the test asserts is non-sentinel.
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK AV RV THETA
