# SIM_WGT_POPULATION parity fixture: GENPDF_EXPON_REWGT sharpens the stretch
# and colour populations and SNANA writes prob(nominal)/prob(sharpened) per
# event. Asymmetric widths, a plateau and a second colour peak exercise every
# branch of funVal_GENGAUSS_ASYM.
# Regenerated by `python tests/fixtures/regenerate.py --only population_rewgt`.
GENVERSION:  JAX_TEST_POPULATION_REWGT
NGENTOT_LC:  600
GENPDF_EXPON_REWGT:  2.0
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  1
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — bundled cropped SALT3.K21
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENPEAK_SALT2x1:    0.2
GENPEAKRANGE_SALT2x1:  -0.1  0.4
GENRANGE_SALT2x1:  -3.0  2.5
GENSIGMA_SALT2x1:   1.5  0.9
GENPEAK_SALT2c:    -0.02
GENRANGE_SALT2c:   -0.3  0.5
GENSIGMA_SALT2c:    0.04  0.08
GENPROB2_SALT2c:    0.3
GENPEAK2_SALT2c:    0.15
GENSIGMA2_SALT2c:   0.03  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Redshift
GENRANGE_REDSHIFT:  0.0200  0.4000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
# Galactic extinction (off; only model parity matters)
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  POWERLAW  2.5E-5  1.5
# Misc
GENSOURCE:  RANDOM
RANSEED:  77123
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 13 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK SALT2x0 SALT2x1 SALT2c WGT_POPULATION
