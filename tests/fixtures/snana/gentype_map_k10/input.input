# DES core-collapse sim whose README carries several GENTYPE_TO_NAME lines.
# Regenerated by `python tests/fixtures/regenerate.py --only gentype_map_k10`.
#
# The bbc_ccprior_sim input without its GENTYPE override, so each K10 template
# keeps its own SNTYPE; Ibc and Ic templates share 33, giving a joined name.
GENVERSION:  JAX_TEST_GENTYPE_MAP
NGENTOT_LC:  200
FORMAT_MASK:  32  # FITS
WRFLAG_MODELPAR:  1
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model -- K10 CC templates, all six subtypes, with their K10 weights
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/NON1ASED.K10_TEST
NON1A_KEYS:  5 INDEX WGT MAGOFF MAGSMEAR SNTYPE
NON1A: 002 0.0800 -0.550 0.640 22   # IIL (Nugent+Scolnic_IIL)
NON1A: 021 0.0167 1.480 1.100 33   # Ibc (SNLS-04D1la)
NON1A: 022 0.0167 1.480 1.100 33   # Ic  (SNLS-04D4jv)
NON1A: 101 0.0167 1.480 1.100 33   # Ic  (CSP-2004fe)
NON1A: 102 0.0167 1.480 1.100 33   # Ic  (CSP-2004gq)
NON1A: 103 0.0200 0.600 0.000 32   # Ib  (CSP-2004gv)
NON1A: 104 0.0200 0.600 0.000 32   # Ib  (CSP-2006ep)
NON1A: 105 0.0200 0.600 0.000 32   # Ib  (CSP-2007Y)
NON1A: 201 0.0246 2.100 1.050 20   # IIP (SDSS-000018)
NON1A: 204 0.0246 2.100 1.050 20   # IIP (SDSS-003818)
NON1A: 206 0.0200 1.500 1.500 21   # IIN (SDSS-012842)
NON1A: 208 0.0246 2.100 1.050 20   # IIP (SDSS-013376)
NON1A: 209 0.0200 1.500 1.500 21   # IIN (SDSS-013449)
NON1A: 210 0.0246 2.100 1.050 20   # IIP (SDSS-014450)
# Cosmology -- matches the BBC reference cosmology (p9=0.7, p11=-1)
OMEGA_MATTER:  0.3000
OMEGA_LAMBDA:  0.7000
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
H0:  70.0
# Instrument -- bundled DES kcor + 10-field griz SIMLIB
GENFILTERS:  griz
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_DES.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_DES.SIMLIB
SOLID_ANGLE:  0.00456   # 15 sq deg, as in SNANA's DES non-Ia input
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# No trigger model, as in SNANA's DES non-Ia input -- the CUTWIN below is the
# selection, so the prior is not shaped by an efficiency curve we would then
# also have to bundle.
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  1
CUTWIN_NEPOCH:   5 -5.
CUTWIN_SNRMAX:   5 griz 2 -20. 80.
# Redshift -- spans the BBC fit window (zmin=0.1, zmax=1.0)
GENRANGE_REDSHIFT:  0.1000  0.9800
GENSIGMA_REDSHIFT:  0.001
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage -- one DES season, matching the SIMLIB's MJD span
GENRANGE_PEAKMJD:  56150.0  56365.0
GENSIGMA_SEARCH_PEAKMJD:  1.0
GENRANGE_TREST:  -40.0  70.0
GENRANGE_RA:    -360.0  360.0
GENRANGE_DECL:  -360.0  360.5
# Host extinction off, as in SNANA's DES non-Ia input
GENTAU_AV:  0.0
# Galactic extinction
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population -- CC rate from the LSST contamination memo, per SNANA's input
DNDZ:  POWERLAW  6.8E-5  3.6
# Misc
GENSOURCE:  RANDOM
RANSEED:  12945
