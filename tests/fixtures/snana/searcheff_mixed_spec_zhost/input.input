# Mixed SDSS SPEC + zHOST: pipeline-passing SNe are split across SPECID,
# zHOST and unconfirmed buckets. Aggregate-rate parity test consumes this.
GENVERSION:  JAX_TEST_SEARCHEFF_MIXED
NGENTOT_LC:  1500
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  20
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/NON1ASED.V19_TEST
NON1A_KEYS:  5 INDEX WGT MAGOFF MAGSMEAR SNTYPE
NON1A: 834 1.0 0.00 0.00 21
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SDSS SPEC curve (SNR + magnitude based)
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_SPEC_SDSS.DAT
SEARCHEFF_zHOST_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_zHOST_SDSS.DAT
APPLY_SEARCHEFF_OPT:  1
APPLY_CUTWIN_OPT:  1
CUTWIN_NEPOCH:   5 -10
CUTWIN_TRESTMIN: -20 0
CUTWIN_TRESTMAX:  0 40
GENRANGE_REDSHIFT:  0.0200  0.3000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -40.0000  85.0000
SOLID_ANGLE:  0.0150
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
DNDZ:  0.7*CC_S15
GENSOURCE:  RANDOM
RANSEED:  122459
# Include PEAKMAG_g / PEAKMAG_r so the parity test can replay them through JAX.
SIMGEN_DUMPALL:  13 CID GENTYPE SNTYPE NON1A_INDEX GENZ LIBID PEAKMJD MU MWEBV CUTMASK SIM_SEARCHEFF_MASK PEAKMAG_g PEAKMAG_r
