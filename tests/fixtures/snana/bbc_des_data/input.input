# DES Ia data sample for the BBC BEAMS tests (the CC contaminants come from
# bbc_ccprior_sim, which must be the same survey -- SALT2mu partitions by IDSURVEY).
# Regenerated by `python tests/fixtures/regenerate.py --only bbc_des_data`.
GENVERSION:  JAX_TEST_BBC_DES_DATA
NGENTOT_LC:  3000
FORMAT_MASK:  32  # FITS
WRFLAG_MODELPAR:  1
GENTYPE:  1
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# SALT3 Ia at a single (alpha, beta) node, as the biasCor expects
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENMEAN_SALT2ALPHA:  0.14
GENMEAN_SALT2BETA:   3.10
GENPEAK_SALT2x1:  0.0
GENSIGMA_SALT2x1:  1.5  1.5
GENRANGE_SALT2x1:  -4.0  4.0
GENPEAK_SALT2c:  0.0
GENSIGMA_SALT2c:  0.08  0.08
GENRANGE_SALT2c:  -0.35  0.55
GENMAG_SMEAR:  0.10
# Cosmology -- the BBC reference cosmology (p9=0.7, p11=-1)
OMEGA_MATTER:  0.3000
OMEGA_LAMBDA:  0.7000
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
H0:  70.0
# Instrument -- bundled DES kcor + 10-field griz SIMLIB
GENFILTERS:  griz
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_DES.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_DES.SIMLIB
SOLID_ANGLE:  0.00456
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
APPLY_SEARCHEFF_OPT:  0
APPLY_CUTWIN_OPT:  1
CUTWIN_NEPOCH:   5 -5.
CUTWIN_SNRMAX:   5 griz 2 -20. 80.
GENRANGE_REDSHIFT:  0.1000  0.9800
GENSIGMA_REDSHIFT:  0.001
GENSIGMA_VPEC:  0
VPEC_ERR:  0
GENRANGE_PEAKMJD:  56150.0  56365.0
GENSIGMA_SEARCH_PEAKMJD:  1.0
GENRANGE_TREST:  -40.0  70.0
GENRANGE_RA:    -360.0  360.0
GENRANGE_DECL:  -360.0  360.5
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population -- volumetric Ia rate (Dilday 2008 powerlaw)
DNDZ:  POWERLAW  2.6E-5  1.5
GENSOURCE:  RANDOM
RANSEED:  38177
