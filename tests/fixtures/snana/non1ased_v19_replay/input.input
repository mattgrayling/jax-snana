# SEARCHEFF SNII parity fixture — uses bundled minimal NON1ASED+SIMLIB+kcor.
# Regenerated by `python tests/fixtures/regenerate.py --only searcheff_snii_basic`.
GENVERSION:  JAX_TEST_NON1ASED_V19_REPLAY
NGENTOT_LC:  1500
FORMAT_MASK:  32  # FITS
WRFLAG_MODELPAR:  1
GENTYPE:  20
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — cropped V19 NON1ASED template (INDEX 834)
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/NON1ASED.V19_TEST
NON1A_KEYS:  5 INDEX WGT MAGOFF MAGSMEAR SNTYPE
NON1A: 834 1.0 0.00 0.00 21
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument — bundled LSST kcor + SIMLIB
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF — bundled LSST DAT files
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   5 -10
CUTWIN_SNRMAX:   3 grizY 2 -20 60
CUTWIN_TRESTMIN: -20 0
CUTWIN_TRESTMAX:  0 40
# Redshift
GENRANGE_REDSHIFT:  0.0200  0.4000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -40.0000  85.0000
SOLID_ANGLE:  0.0150
# Galactic extinction
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  0.7*CC_S15
# Misc
GENSOURCE:  RANDOM
RANSEED:  122459
SIMGEN_DUMPALL:  10 CID GENTYPE SNTYPE NON1A_INDEX GENZ LIBID PEAKMJD MU MWEBV CUTMASK
