# BayeSN W22 + HOSTLIB SN2GAL_Z (MSKOPT bit 16): the SN redshift is replaced
# by the host's ZTRUE after sampling, so dlmag is recomputed post-draw — pins
# apply_dlmag_delta reaching non-SALT fluxes (Ds shift for BayeSN).
# GENMODEL_MSKOPT 64 (replayable). HOSTLIB_MSKOPT 274 = 2 + 16 + 256.
# Regenerated by `python tests/fixtures/regenerate.py --only hostlib_sn2galz_bayesn`.
GENVERSION:  JAX_TEST_HOSTLIB_SN2GALZ_BAYESN
NGENTOT_LC:  2500
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  10
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — bundled BayeSN W22
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/BAYESN.W22
GENMODEL_MSKOPT:  64
GENPEAK_THETA:  0.0
GENRANGE_THETA: -1.5  1.5
GENSIGMA_THETA: 0.7  0.7
GENPEAK_DELTAM:  0.0
GENRANGE_DELTAM: -0.4  0.4
GENSIGMA_DELTAM: 0.1  0.1
# HOSTLIB with SN2GAL_Z
HOSTLIB_FILE:        $JAX_TEST_FIXTURE_ROOT/hostlib/JAX_TEST.HOSTLIB
HOSTLIB_MSKOPT:      274
HOSTLIB_DZTOL:       0.0,0.05,0
HOSTLIB_STOREPAR:    LOGMASS
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  1
SMEARFLAG_ZEROPT:  1
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Redshift — inside the HOSTLIB galaxy z range (0.02-0.5)
GENRANGE_REDSHIFT:  0.0500  0.3000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
# Host extinction (BayeSN requires AV/RV to be sampled)
GENRANGE_AV:  0.0  0.5
GENTAU_AV:   0.4
GENRANGE_RV:  2.5  3.5
GENMEAN_RV:   3.1
GENSIGMA_RV:  0.3  0.3
# Galactic extinction
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  POWERLAW2 2.5E-5  1.5  0.0  0.4
# Misc
GENSOURCE:  RANDOM
RANSEED:  122459
OPT_SETPKMJD: 0
SIMGEN_DUMPALL: 12 CID GENTYPE SNTYPE GENZ LIBID PEAKMJD MU MWEBV CUTMASK AV RV THETA
