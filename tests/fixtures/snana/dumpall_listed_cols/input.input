# DUMPALL fixture asking for every column jax's SIMGEN_DUMP: 0 listing
# offers that a run with no HOSTLIB, lensing map or coordinate shift can
# supply, every SALT name included. SNANA aborts on a name it does not
# know, so running it is what says the listing names real columns.
# FLAG_ACCEPT is left out because both codes append it
# (snlc_sim.c:4919-4923).
GENVERSION:  JAX_TEST_DUMPALL_LISTED
NGENTOT_LC:  80
FORMAT_MASK:  32
WRFLAG_MODELPAR:  1
GENTYPE:  1
SNTYPES_Ia:  1  101
CIDRAN_MIN:  0
CIDRAN_MAX:  3000000
# Source model — bundled cropped SALT3.K21
GENMODEL:  $JAX_TEST_FIXTURE_ROOT/models/SALT3.K21
GENPEAK_SALT2x1:    0.0
GENRANGE_SALT2x1:  -2.0  2.0
GENSIGMA_SALT2x1:   1.0  1.0
GENPEAK_SALT2c:     0.0
GENRANGE_SALT2c:   -0.2  0.3
GENSIGMA_SALT2c:    0.05  0.05
GENPEAK_SALT2ALPHA: 0.14
GENPEAK_SALT2BETA:  3.1
# Cosmology
OMEGA_MATTER:  0.3150
OMEGA_LAMBDA:  0.6850
w0_LAMBDA:  -1.0000
wa_LAMBDA:  0
# Instrument
GENFILTERS:  ugrizY
KCOR_FILE:  $JAX_TEST_FIXTURE_ROOT/kcor/JAX_TEST_LSST.fits
SIMLIB_FILE:  $JAX_TEST_FIXTURE_ROOT/simlib/JAX_TEST_LSST.SIMLIB
SIMLIB_MINSEASON:  30
SMEARFLAG_FLUX:  0  # noise-free fluxes, so SNRMAX is deterministic
SMEARFLAG_ZEROPT:  1
# SEARCHEFF
SEARCHEFF_PIPELINE_LOGIC_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LOGIC_LSST.DAT
NEWMJD_DIF:  0.0210
SEARCHEFF_PIPELINE_EFF_FILE:  $JAX_TEST_FIXTURE_ROOT/searcheff/SEARCHEFF_PIPELINE_LSST.DAT
SEARCHEFF_SPEC_FILE:  NONE
SEARCHEFF_zHOST_FILE:  NONE
APPLY_SEARCHEFF_OPT:  0
# Selection cuts
APPLY_CUTWIN_OPT:  0
CUTWIN_NEPOCH:   1 -10
CUTWIN_TRESTMIN: -50 50
CUTWIN_TRESTMAX: -50 50
# Redshift
GENRANGE_REDSHIFT:  0.0200  0.4000
GENSIGMA_REDSHIFT:  1.0000e-03
GENSIGMA_VPEC:  0
VPEC_ERR:  0
# Epoch & sky coverage
GENRANGE_MJD:  60500.0000  61500.0000
GENRANGE_PEAKMJD:  60540.0000  61460.0000
GENSIGMA_PEAKMJD:  1.0000
GENRANGE_TREST:  -20.0000  50.0000
SOLID_ANGLE:  0.0150
# Galactic extinction (off; only model parity matters)
OPT_MWEBV:  0
OPT_MWCOLORLAW:  99
# Population
DNDZ:  POWERLAW  2.5E-5  1.5
# Misc
GENSOURCE:  RANDOM
RANSEED:  122459
OPT_SETPKMJD: 0
# TRESTMIN and TRESTMAX are left out: SNANA reports the values of an
# earlier loop over every SIMLIB epoch that gen_cutwin never resets
# (SIMLIB_prepCadence, snlc_sim.c:20427-20431).
SIMGEN_DUMPALL: 64 S2x0 SALT2x0 SIM_x0 S2x1 SALT2x1 SIM_x1 S2c SALT2c SIM_c S2mb SALT2mb SALT2mB SIM_mb SIM_mB SALT2alpha S2alpha SIM_alpha SALT2beta S2beta SIM_beta SALT2gammaDM SNMAGSHIFT CID GENTYPE SNTYPE NON1A_INDEX NONIA_INDEX SIM_TEMPLATE_INDEX GENZ ZCMB ZHELIO LIBID FIELD RA DEC MWEBV MWEBVMAP MWEBVERR MU PEAKMJD CUTMASK TRESTMIN TMIN TRESTMAX TGAPMAX NOBS NEPOCH SNRMAX SNRMAX1 SNRMAX2 SNRMAX3 SNRMAX4 SNRMAX5 SIM_SEARCHEFF_MASK SIM_EFFMASK MJD_TRIGGER MJD_DETECT_FIRST MJD_DETECT_LAST REDSHIFT_FINAL VPEC LENSDMU SPEC_SNRSUM_REST_V AV RV
