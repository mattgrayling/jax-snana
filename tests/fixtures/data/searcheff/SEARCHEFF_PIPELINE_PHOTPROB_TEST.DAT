DOCUMENTATION:
    PURPOSE: Synthetic SEARCHEFF pipeline with PHOTPROB maps for testing
    INTENT: Test
    USAGE_KEY: SEARCHEFF_PIPELINE_EFF_FILE
    USAGE_CODE: snlc_sim.exe
    VERSIONS:
    - DATE: 2026
      AUTHORS: JAX-SNANA test
DOCUMENTATION_END:

PHOTFLAG_DETECT:   4096
PHOTFLAG_TRIGGER:  2048

MAPNAME_DETECT: DET_u
FILTER: u
ABS(SNR): 0.00 0
ABS(SNR): 3.00 0
ABS(SNR): 5.00 1.0
ABS(SNR): 50.0 1.0
ENDMAP:

MAPNAME_DETECT: DET_g
FILTER: g
