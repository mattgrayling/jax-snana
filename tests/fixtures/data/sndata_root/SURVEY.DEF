# generic survey or model names
SURVEY:  SIMSED    180
SURVEY:  FLASH     181  # for FLASH+RT simulations with SIMSED option
SURVEY:  TEST      190  # test simlib, such as ideal 2 day cadence
SURVEY:  OTHER     191  # e.g., other lowz in JLA training


# ==============================================================
