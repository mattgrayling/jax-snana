FIELD: MD02   02  PS1MD
FIELD: MD03   03  PS1MD
FIELD: MD04   04  PS1MD
FIELD: MD05   05  PS1MD
FIELD: MD06   06  PS1MD
FIELD: MD07   07  PS1MD
FIELD: MD08   08  PS1MD
FIELD: MD09   09  PS1MD
FIELD: MD10   10  PS1MD


# WFIRST field(s)
FIELD: W1       00  WFIRST
FIELD: DEEP     01  WFIRST
FIELD: MEDIUM   02  WFIRST
FIELD: SHALLOW  03  WFIRST

