DUPLICATE_LAMSHIFT_GLOBAL: 10
# Mixed standards, detector response conventions and magnitude conversions.
AB_SED: ab.dat
BD17_SED: bd17.dat
MAGSYSTEM: AB
FILTSYSTEM: COUNT
SURVEY: DES
FILTPATH: .
FILTER: Test-g g.dat 0.0+.003-.001
MAGSYSTEM: BD17
FILTSYSTEM: ENERGY
SURVEY: DES
FILTPATH: .
FILTER: Test-r r.dat 9.8+.002
MAGSYSTEM: BD17->AB
FILTSYSTEM: COUNT
SURVEY: DES
FILTPATH: .
FILTER: Test-i i.dat 9.8
MAGSYSTEM: AB->BD17
SURVEY: DES
FILTPATH: .
FILTER: Test-z z.dat 0.0
LAMBDA_RANGE: 3000 9000
MAGSYSTEM: AB
FILTSYSTEM: COUNT
SURVEY: DES
FILTPATH: .
SPECTROGRAPH: spectrograph.dat
SYN_FILTER: IFU-u 4000 4400 0.0
SYN_FILTER: IFU-v 5900 6300 0.0
OUTFILE: calibration_spectrograph_duplicate.fits
